+// clickByDirectText 点击页面上直接文本等于 text（prefix 为 true 时是以 text 开头）且可见的元素。
+// 只看元素自己的文本节点，避免点到包含这段文字的父容器。
+func (a *CreatorLoginAction) clickByDirectText(text string, prefix bool) bool {
+	res, err := a.page.Eval(fmt.Sprintf(`() => {
+		const want = %q, prefix = %t;
+		for (const el of document.querySelectorAll('*')) {
+			const direct = Array.from(el.childNodes)
+				.filter(n => n.nodeType === 3)
+				.map(n => n.textContent.trim())
+				.join('');
+			if (!(prefix ? direct.startsWith(want) : direct === want)) continue;
+			const r = el.getBoundingClientRect();
+			if (r.width === 0 || r.height === 0) continue;
+			el.click();
+			return true;
+		}
+		return false;
+	}`, text, prefix))
+	return err == nil && res.Value.Bool()
+}
+
+// tickAgreement 勾选登录表单里「我已阅读并同意」的协议复选框（已勾选就不动）
+func (a *CreatorLoginAction) tickAgreement() {
+	res, err := a.page.Eval(`() => {
+		for (const box of document.querySelectorAll('input[type=checkbox]')) {
+			if (box.checked) return 'already';
+			const target = box.closest('label') || box;
+			target.click();
+			if (!box.checked) box.click();
+			return box.checked ? 'ticked' : 'failed';
+		}
+		return 'none';
+	}`)
+	if err != nil {
+		logrus.Warnf("勾选用户协议失败（non-fatal）: %v", err)
+		return
+	}
+	logrus.Infof("用户协议复选框: %s", res.Value.Str())
+}
+
