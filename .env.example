# LLM：任意 OpenAI 兼容接口（DeepSeek / 通义千问 / Moonshot / OpenAI 等）
# 不填 LLM_API_KEY 时自动使用 FakeLLM，方便离线跑通流程和测试
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# 只支持流式请求的中转服务（报 Non-stream ... not supported）设为 true
LLM_STREAM=false

# Embedding：RETRIEVER=pgvector 和 xhs-db init/import 需要。任意 OpenAI 兼容 /embeddings 接口
# 例：通义 https://dashscope.aliyuncs.com/compatible-mode/v1 + text-embedding-v3
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=
# 可选：模型支持 dimensions 参数时指定输出维度
EMBED_DIMENSIONS=

# 检索：memory（默认，读 data/sample_notes.jsonl）或 pgvector
RETRIEVER=memory
# 状态存储：memory（默认，重启丢失未确认的运行）或 postgres（checkpoint + runs 表）
STORAGE=memory
# 远程库建议走 SSH 隧道，不要把 5432 暴露到公网
DATABASE_URL=postgresql://xhs:密码@127.0.0.1:5433/xhs

MAX_REVIEW_RETRIES=2
MAX_FORMAT_RETRIES=1
OUTPUT_DIR=outputs
LOG_FILE=logs/runs.jsonl

# 发布到小红书（可选）：调用外部 xiaohongshu-mcp（浏览器自动化，非小红书官方 API，见 README）
# 留空 XHS_MCP_URL 就不启用，结果页不会出现「发布」按钮
# pip install -e ".[publish]"；先用 xiaohongshu-mcp 自带的登录工具扫码登录一次
XHS_MCP_URL=
XHS_MCP_TIMEOUT=90
# xiaohongshu-mcp 用来拉取封面/图片的地址；同机器本地调试可留空（用请求本身的 host）
# 分开部署（例如 Docker 网络里）要填本服务对 xiaohongshu-mcp 可达的地址，例：http://web:8000
PUBLIC_BASE_URL=
