# 联想本 dev 环境配置（无密钥，可进 git；要调真实模型时自己填 LLM_API_KEY）
# 对应用 sub2api 中转：LLM_BASE_URL=https://sub2api.czczccc.space/v1 / LLM_MODEL=deepseek-v4.1-flash / LLM_STREAM=true
LLM_BASE_URL=https://sub2api.czczccc.space/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4.1-flash
# 只支持流式请求的中转服务设为 true
LLM_STREAM=true

EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=
EMBED_DIMENSIONS=

# dev 默认轻量：memory 检索 + memory 存储，不依赖 pg
RETRIEVER=memory
STORAGE=memory
# dev 免试用码，方便直接测流程；prod 保持 true
REQUIRE_SHOP_CODE=false
DATABASE_URL=postgresql://xhs:xhs@db:5432/xhs

MAX_REVIEW_RETRIES=2
MAX_FORMAT_RETRIES=1
OUTPUT_DIR=outputs
LOG_FILE=logs/runs.jsonl

# dev 默认不启用小红书发布；要测发布时再填（compose 里 app 已可通过服务名访问 mcp）
XHS_MCP_URL=
XHS_MCP_TIMEOUT=90
PUBLIC_BASE_URL=
